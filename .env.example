# Copy to .env (never commit .env). Used by `manage.py`.

# --- Django ---
# Generate one:  python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated https origins, needed behind a proxy / custom domain, e.g. https://milestone.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=
# Set to false only when serving plain http (local Docker).
DJANGO_SECURE_SSL_REDIRECT=true

# --- PostgreSQL ---
DATABASE_URL=postgres://milestone:milestone@localhost:5432/milestone
DATABASE_SSL_REQUIRE=false
# Used only by docker-compose for the bundled database container
POSTGRES_PASSWORD=milestone

# --- JWT (SimpleJWT) ---
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# --- CORS (only when the React dev server runs on another origin) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Gemini (server-side only; never exposed to the browser) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Maximum time the server waits for Gemini before returning a retryable error.
GEMINI_TIMEOUT_SECONDS=30

# --- Rate limits (per user for AI, per IP for login/register) ---
THROTTLE_AUTH=20/min
THROTTLE_AI=30/min
